// upscale_2x.comp  –  Generic NCNN-weight-driven super-resolution shader
// Compiled at runtime by Upscaler::createComputePipeline()
// Macros injected by the host:
//   SCALE_FACTOR  (e.g. 2)
//   TILE_W / TILE_H

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

// ── Workgroup ─────────────────────────────────────────────────────────────────
#ifndef SCALE_FACTOR
#define SCALE_FACTOR 2
#endif

#ifndef TILE_W
#define TILE_W 512
#endif

#ifndef TILE_H
#define TILE_H 512
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ── Bindings (must match Upscaler::kBinding*) ─────────────────────────────────
layout(binding = 0) uniform sampler2D srcImage;     // input  (RGBA8 / RGBA32F)
layout(binding = 1, rgba32f) uniform image2D dstImage; // output (RGBA32F storage)

layout(binding = 2) readonly buffer Weights
{
    float data[];   // packed: [layer0_weights | layer0_bias | layer1_weights | …]
} weights;

layout(binding = 3) buffer Scratch
{
    float data[];   // intermediate feature maps for multi-layer inference
} scratch;

// ── Push constants ────────────────────────────────────────────────────────────
layout(push_constant) uniform PC
{
    uvec2 srcSize;
    uvec2 dstSize;
    uvec2 tileOffset;
    uvec2 tileSize;
    float scaleFactor;
    uint  channels;
    uint  _pad0;
    uint  _pad1;
} pc;

// ── Helpers ───────────────────────────────────────────────────────────────────

// Bilinear sample from the source image (normalised UV)
vec4 sampleSrc(vec2 uv)
{
    return texture(srcImage, clamp(uv, vec2(0.0), vec2(1.0)));
}

// Map a dst-space pixel to src-space UV
vec2 dstPixelToSrcUV(uvec2 dstPx)
{
    // Centre-aligned mapping  (same as typical ESRGAN pre-/post-processing)
    vec2 srcPx = (vec2(dstPx) + 0.5) / float(SCALE_FACTOR) - 0.5;
    return (srcPx + 0.5) / vec2(pc.srcSize);
}

// ── Main ──────────────────────────────────────────────────────────────────────
void main()
{
    // Global dst-image coordinates for this invocation
    const uvec2 dstCoord = gl_GlobalInvocationID.xy
                         + pc.tileOffset * uint(SCALE_FACTOR);

    if (dstCoord.x >= pc.dstSize.x || dstCoord.y >= pc.dstSize.y)
        return;

    const vec2 uv = dstPixelToSrcUV(dstCoord);

    // ── Minimal single-pass bicubic interpolation ─────────────────────────
    //  Production models would replace this body with multi-layer conv logic
    //  reading from weights.data[] and writing intermediates to scratch.data[].

    // Bicubic kernel weight
    vec4 col = vec4(0.0);
    {
        vec2 srcPxF = uv * vec2(pc.srcSize) - 0.5;
        ivec2 base  = ivec2(floor(srcPxF));
        vec2  frac  = srcPxF - vec2(base);

        // 4×4 neighbourhood
        for (int dy = -1; dy <= 2; dy++)
        {
            float wy = 0.0;
            {   // Mitchell-Netravali B=1/3, C=1/3
                float t = abs(float(dy) - frac.y);
                wy = (t < 1.0)
                    ? (7.0*t*t*t - 12.0*t*t + 16.0/3.0) / 6.0
                    : ((-7.0*t*t*t + 36.0*t*t - 60.0*t + 32.0) / 6.0);
            }

            for (int dx = -1; dx <= 2; dx++)
            {
                float wx = 0.0;
                {
                    float t = abs(float(dx) - frac.x);
                    wx = (t < 1.0)
                        ? (7.0*t*t*t - 12.0*t*t + 16.0/3.0) / 6.0
                        : ((-7.0*t*t*t + 36.0*t*t - 60.0*t + 32.0) / 6.0);
                }

                ivec2 sampleCoord = clamp(base + ivec2(dx, dy),
                                         ivec2(0),
                                         ivec2(pc.srcSize) - ivec2(1));
                vec4 s = texelFetch(srcImage, sampleCoord, 0);
                col += wx * wy * s;
            }
        }
    }

    imageStore(dstImage, ivec2(dstCoord), col);
}
